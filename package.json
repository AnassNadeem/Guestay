{
  "name": "guestay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:admin": "npm --prefix admin run dev",
    "build": "next build",
    "build:admin": "npm --prefix admin run build",
    "deploy:admin": "npm --prefix admin run build && npm --prefix admin run deploy",
    "start": "next start",
    "lint": "next lint",
    "expire-holds": "curl -X POST http://localhost:3000/api/cron/expire-holds",
    "seed:dev-users": "SEED_DEV_USERS=1 npx tsx scripts/seed-dev-users.ts",
    "seed:e2e-guest": "SEED_E2E_GUEST=1 npx tsx scripts/seed-e2e-guest.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "node scripts/stub-sentry-wasm.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:preview": "opennextjs-cloudflare build && wrangler deploy --env preview",
    "deploy:production": "opennextjs-cloudflare build && wrangler deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.26.0",
    "next": "15.5.22",
    "nodemailer": "^9.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.1",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "undici": "^7.29.0",
    "postcss": "^8.5.25"
  }
}
