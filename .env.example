# =============================================================================
# Guestay — environment template
# =============================================================================
# 1. Copy this file:  cp .env.example .env.local   (PowerShell: Copy-Item .env.example .env.local)
# 2. Fill in real values in .env.local only — never commit .env.local
# 3. Values marked NEXT_PUBLIC_ are exposed to the browser; keep secrets without that prefix
#
# Phase guide:
#   Phase 1  → Site / contact / Spline section
#   Phase 2A → Supabase + Safepay + Zoho (+ Owner email)
#   Phase 2B → OTA iCal URLs (often stored in admin DB; listed here for local testing)
#   Deploy   → Cloudflare (usually wrangler login / secrets, not required in .env.local)
# =============================================================================


# -----------------------------------------------------------------------------
# Site / contact (Phase 1)
# -----------------------------------------------------------------------------

# Public site origin (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin app origin (Refine). Local example: http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Primary phone for tel: links — E.164
NEXT_PUBLIC_PHONE=+923073050505

# Secondary phone (optional)
NEXT_PUBLIC_PHONE_SECONDARY=+923410050505

# WhatsApp number — digits only, country code, no + (used in wa.me links)
NEXT_PUBLIC_WHATSAPP=923073050505

# Public contact email shown in footer / contact page
NEXT_PUBLIC_CONTACT_EMAIL=hello@guestay.pk

# Inbox for Contact Us form enquiries (server). Defaults to hello@guestay.pk
CONTACT_TO_EMAIL=hello@guestay.pk

# Optional: forward contact-form POSTs to n8n or a Worker (server-only)
CONTACT_WEBHOOK_URL=

# Social profile URLs (footer). Leave blank to hide a link.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Spline hero — removed; hero is text + search only (no credential needed)
# NEXT_PUBLIC_SPLINE_SCENE_URL=


# -----------------------------------------------------------------------------
# Supabase (Phase 2A) — Project Settings → API
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY

# Server / Workers only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# First Owner account (used in seed / bootstrap — not a secret key)
OWNER_BOOTSTRAP_EMAIL=you@guestay.pk


# -----------------------------------------------------------------------------
# Safepay (Phase 2A) — sandbox first, then production at go-live
# -----------------------------------------------------------------------------

# sandbox | production
SAFEPAY_ENV=sandbox

# Public / merchant API key (client button may need the public form)
SAFEPAY_API_KEY=sec_YOUR_SANDBOX_API_KEY
NEXT_PUBLIC_SAFEPAY_API_KEY=sec_YOUR_SANDBOX_API_KEY

# Secret key — server / Worker only
SAFEPAY_SECRET_KEY=YOUR_SAFEPAY_SECRET_KEY

# Webhook signing secret — leave blank until the Worker is deployed (Phase 2A).
# There is no URL yet: we create the Worker first, then you register that URL in Safepay,
# then Safepay gives you the signing secret to paste here.
SAFEPAY_WEBHOOK_SECRET=

# Optional: override API hosts (defaults are fine for most setups)
# SAFEPAY_API_HOST=https://sandbox.api.getsafepay.com
# SAFEPAY_API_HOST=https://api.getsafepay.com


# -----------------------------------------------------------------------------
# Zoho Mail SMTP (Phase 2A) — optional for Contact Us / bookings only
# Prefer Cloudflare Email Sending for Auth (signup/reset) so Zoho free tier
# is not burned by transactional mail. Contact form can still use Zoho SMTP
# or a Worker later. Prefer Cloudflare Worker secrets in production.
# -----------------------------------------------------------------------------

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=bookings@guestay.pk
ZOHO_SMTP_PASS=YOUR_ZOHO_APP_PASSWORD
# From must match SMTP user (or an alias on that mailbox). Contact form still sends *to* CONTACT_TO_EMAIL.
ZOHO_FROM_EMAIL=bookings@guestay.pk
ZOHO_FROM_NAME=Guestay

# -----------------------------------------------------------------------------
# Supabase Auth emails (signup / reset) — configure in Dashboard, not .env
#
# Prefer Resend (free tier) so Zoho is not used for Auth mail.
# Cloudflare Email Routing only RECEIVES; do not use it for sending.
#
# Resend → Domains → verify guestay.pk, then Supabase → Auth → SMTP:
#      Host:     smtp.resend.com
#      Port:     465
#      Username: resend
#      Password: re_… (Resend API key)
#      Sender:   Guestay <noreply@guestay.pk>
# Auth → URL Configuration — add (exact match required for Google OAuth):
#      http://localhost:3000/auth/callback
#      https://guestay.pk/auth/callback
# Site URL (Auth → URL Configuration): http://localhost:3000 (dev) or https://guestay.pk
# Google provider: Authentication → Providers → Google (Client ID + Secret)
# Recovery template MUST include {{ .Token }} (OTP length from Auth settings; often 8)
# Confirm signup can keep {{ .ConfirmationURL }}
# -----------------------------------------------------------------------------

# Plivo (deferred) — leave blank; phone Verify Now stays disabled / Coming soon
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_FROM_NUMBER=


# -----------------------------------------------------------------------------
# Cloudflare (deploy / Workers)
# If CLOUDFLARE_API_TOKEN is set below, do NOT run `npx wrangler login` —
# Wrangler will use the token and OAuth login will error. That is fine.
# Only run `npx wrangler login` if you clear/unset CLOUDFLARE_API_TOKEN first.
# -----------------------------------------------------------------------------

CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# Set after Workers are deployed (Phase 2A/2B). Leave empty for now.
# Safepay dashboard webhook URL will be SAFEPAY_WEBHOOK_WORKER_URL once it exists.
EMAIL_WORKER_URL=
ICAL_WORKER_BASE_URL=
SAFEPAY_WEBHOOK_WORKER_URL=


# -----------------------------------------------------------------------------
# Booking holds / product defaults (Phase 2A) — usually fine as-is
# -----------------------------------------------------------------------------

# Soft inventory lock while guest is on checkout (server + client)
BOOKING_HOLD_MINUTES=15
# Grace window shown inside the "Keep My Room" modal only
NEXT_PUBLIC_HOLD_GRACE_SECONDS=90
NEXT_PUBLIC_HOLD_MINUTES=15

# Legacy alias (converted to minutes if BOOKING_HOLD_MINUTES unset)
# BOOKING_HOLD_HOURS=2

DIRECT_BOOKING_DEPOSIT_DISCOUNT=0.10
GROUP_NO_ADVANCE_MIN_GUESTS=10

# Optional cron auth for /api/cron/expire-holds
CRON_SECRET=


# -----------------------------------------------------------------------------
# OTA iCal — Phase 2B (optional here; normally configured in admin UI)
# -----------------------------------------------------------------------------

# Example inbound feeds for local testing only
# AIRBNB_ICAL_URL_ROOM_A=
# BOOKING_COM_ICAL_URL_ROOM_A=


# -----------------------------------------------------------------------------
# PayFast (optional — not required for v1; gateway interface only)
# -----------------------------------------------------------------------------

# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_ENV=sandbox
